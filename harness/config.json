    "byWeek": {
      "9": {
        "provider": "bedrock",
        "sdk": "boto3",
        "api": "converse",
        "model": "RESOLVE_AT_RESEARCH_TIME",
        "envKey": "AWS_BEARER_TOKEN_BEDROCK"
      }
    },
    "rule": "Model ids are resolved in the research brief from current docs, never from memory."
  },
  "trainerRepo": {
    "path": "trainer",
    "note": "Separate private git repo cloned at ./trainer and gitignored by this repo."
  }
